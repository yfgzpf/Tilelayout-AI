# ============================================================
# 排砖宝 · 腾讯云生产环境变量 (替换所有 { } 占位符)
# ============================================================
# 部署步骤:
#   1. 复制此文件为 .env (不要提交到 Git)
#   2. 替换所有 {REPLACE_ME} 为真实值
#   3. docker compose up -d
# ============================================================

# ---------- 数据库 ----------
DB_USER=tilelayout
DB_PASSWORD={REPLACE_ME_强随机32位}
DB_NAME=tilelayout

# ---------- Redis ----------
REDIS_PASSWORD={REPLACE_ME_强随机32位}

# ---------- JWT ----------
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET={REPLACE_ME_secrets.token_hex(32)}

# ---------- CORS ----------
# 逗号分隔，生产环境只放真实域名
CORS_ORIGINS=https://app.paizhuanbao.com,https://www.paizhuanbao.com

# ---------- 腾讯云 COS (对象存储) ----------
# 在腾讯云 CAM 创建子账号，仅授予 COS 读写权限
# https://console.cloud.tencent.com/cam/capi
COS_SECRET_ID={REPLACE_ME_SecretId}
COS_SECRET_KEY={REPLACE_ME_SecretKey}
COS_REGION=ap-guangzhou
COS_BUCKET=tilelayout-prod-{APPID}

# ---------- 业务配置 ----------
MEMBER_REQUIRED=true
ENVIRONMENT=production
MAX_UPLOAD_SIZE_MB=20
FREE_MONTHLY_LIMIT=3

# ---------- 腾讯云 CLS 日志 ----------
CLS_SECRET_ID={REPLACE_ME}
CLS_SECRET_KEY={REPLACE_ME}
CLS_REGION=ap-guangzhou
CLS_TOPIC_ID={REPLACE_ME}

# ---------- 域名 ----------
APP_DOMAIN=app.paizhuanbao.com
API_DOMAIN=api.paizhuanbao.com
STATIC_DOMAIN=static.paizhuanbao.com
