{
  "name": "@tilelayout/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:cap": "pnpm build && cap sync",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
